# Dependencies. Only needed to REBUILD js/swap.js; the built bundle is committed
# because GitHub Pages serves this directory as-is, with no build step.
node_modules/

# esbuild staging. These are copies of the client's compiled output, pulled in
# so web3.js resolves from one place. Regenerated by `node build.mjs`.
.build/

# Keys must never reach a repository, public or private. No keypair belongs in
# this directory at all — this is a belt-and-braces catch, not a plan.
keys/
*keypair*.json
*-deployer.json
*-committer.json
id.json

# OS noise
.DS_Store
Thumbs.db
